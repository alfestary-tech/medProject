QMainWindow,
QWidget#centralwidget,
QWidget#LoginWindow,
QWidget#RegistrationWindow {
    background: #292D31;
    color: #F3F5F6;
    font-family: "Helvetica Neue", "Segoe UI", Arial;
    font-size: 13px;
}

QLabel {
    color: #B7C0C7;
    background: transparent;
    border: none;
}

QLabel#filesHeader,
QLabel#mainViewHeader,
QLabel#frontViewHeader,
QLabel#sideViewHeader {
    color: #F3F5F6;
    font-size: 15px;
    font-weight: 600;
    padding: 3px 2px;
}

QTabWidget#windowList::pane {
    background: #363B40;
    border: 1px solid #626C75;
    border-radius: 10px;
    top: -1px;
}

QWidget#imageSlice,
QWidget#maskSlice,
QWidget#doseSlice,
QWidget#metaData {
    background: #363B40;
}

QTabBar::tab {
    background: #424950;
    color: #B7C0C7;
    border: 1px solid #626C75;
    border-bottom: none;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    margin-right: 4px;
    padding: 12px 18px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #4E575F;
    color: #F3F5F6;
    border-bottom: 3px solid #AEB7BF;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #555F68;
    color: #F3F5F6;
}

QFrame#mainViewFrame,
QFrame#frontViewFrame,
QFrame#sideViewFrame,
QListWidget#fileList {
    background: #424950;
    border: 1px solid #626C75;
    border-radius: 10px;
}

QListWidget#fileList {
    color: #F3F5F6;
    padding: 8px;
    outline: none;
}

QListWidget#fileList::item {
    padding: 9px 11px;
    border-radius: 7px;
}

QListWidget#fileList::item:hover {
    background: #59636B;
}

QListWidget#fileList::item:selected {
    background: #626C75;
    color: #FFFFFF;
}

QTreeWidget#studyTree {
    background: #363B40;
    color: #F3F5F6;
    border: 1px solid #626C75;
    border-radius: 10px;
    outline: none;
    font-size: 13px;
}

QTreeWidget#studyTree::item {
    padding: 7px 8px;
    border-bottom: 1px solid #424950;
}

QTreeWidget#studyTree::item:hover {
    background: #424950;
}

QTreeWidget#studyTree::item:selected {
    background: #555F68;
    color: #FFFFFF;
}

QLabel#sliceCounter {
    color: #B7C0C7;
    font-size: 12px;
    font-weight: 500;
    padding: 0 4px;
}

QPushButton {
    color: #F3F5F6;
    background: #424950;
    border: 1px solid #626C75;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background: #555F68;
    border-color: #8E9AA3;
}

QPushButton:pressed {
    background: #3A4249;
}

QPushButton#logOutButton {
    color: #B7C0C7;
    background: #363B40;
    border: 1px solid #626C75;
    padding: 5px 9px;
}

QPushButton#logOutButton:hover {
    color: #F3F5F6;
    background: #4E575F;
    border-color: #8E9AA3;
}

QPushButton#folderButton {
    color: #B7C0C7;
    background: transparent;
    border: 1px solid transparent;
    padding: 5px 8px;
    font-size: 12px;
}

QPushButton#folderButton:hover {
    color: #F3F5F6;
    background: #424950;
    border-color: #626C75;
}

QSlider#sliceSlider {
    background: #292D31;
    border: none;
}

QSlider#sliceSlider::groove:horizontal {
    height: 7px;
    background: #626C75;
    border-radius: 3px;
}

QSlider#sliceSlider::sub-page:horizontal {
    background: #AEB7BF;
    border-radius: 3px;
}

QSlider#sliceSlider::add-page:horizontal {
    background: #626C75;
    border-radius: 3px;
}

QSlider#sliceSlider::handle:horizontal {
    width: 17px;
    height: 17px;
    margin: -6px 0;
    background: #F3F5F6;
    border: 2px solid #AEB7BF;
    border-radius: 9px;
}

QSlider#sliceSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border-color: #D6DDE2;
}

QSlider#sliceSlider::groove:horizontal:disabled {
    background: #4E575F;
}

QSlider#sliceSlider::handle:horizontal:disabled {
    background: #7F8992;
    border-color: #7F8992;
}

QFrame#card {
    background: #363B40;
    border: 1px solid #626C75;
    border-radius: 16px;
}

QLabel#titleLabel {
    color: #F3F5F6;
    font-size: 28px;
    font-weight: 700;
    padding-bottom: 10px;
}

QLabel#loginLabel,
QLabel#passwordLabel {
    color: #B7C0C7;
    font-size: 12px;
    font-weight: 600;
    padding-top: 3px;
}

QLineEdit {
    color: #F3F5F6;
    background: #424950;
    border: 1px solid #626C75;
    border-radius: 8px;
    padding: 7px 11px;
    selection-background-color: #626C75;
}

QLineEdit:hover {
    border-color: #8E9AA3;
}

QLineEdit:focus {
    background: #4A535B;
    border: 2px solid #C5CDD4;
}

QPushButton#loginButton,
QWidget#RegistrationWindow QPushButton#registerButton {
    color: #252A2E;
    background: #AEB7BF;
    border: 1px solid #D6DDE2;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton#loginButton:hover,
QWidget#RegistrationWindow QPushButton#registerButton:hover {
    background: #C5CDD4;
    border-color: #E5E9EC;
}

QPushButton#loginButton:pressed,
QWidget#RegistrationWindow QPushButton#registerButton:pressed {
    background: #929DA6;
}

QWidget#LoginWindow QPushButton#registerButton,
QPushButton#backButton {
    color: #B7C0C7;
    background: transparent;
    border: none;
    font-weight: 600;
}

QWidget#LoginWindow QPushButton#registerButton:hover,
QPushButton#backButton:hover {
    color: #F3F5F6;
    background: #4E575F;
}

QPushButton#backButton {
    text-align: left;
}

QMenuBar {
    color: #D6DDE2;
    background: #363B40;
    border-bottom: 1px solid #626C75;
    padding: 4px;
}

QMenuBar::item {
    padding: 5px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    color: #F3F5F6;
    background: #4E575F;
}

QMenu {
    color: #F3F5F6;
    background: #424950;
    border: 1px solid #626C75;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 25px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #59636B;
}

QStatusBar {
    color: #B7C0C7;
    background: #292D31;
    border-top: 1px solid #626C75;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

QScrollBar:vertical {
    width: 10px;
    background: #424950;
    border: none;
}

QScrollBar::handle:vertical {
    background: #626C75;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #8E9AA3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
